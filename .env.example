DATABASE_URL="postgresql://user:password@localhost:5432/sgc?schema=public"
# Required by prisma/schema.prisma's `directUrl` — used specifically by `prisma db push`
# / `prisma migrate`, which need a direct (non-pooled) Postgres connection. If DATABASE_URL
# points at a pooled/proxied connection (e.g. Prisma Postgres / Accelerate, db.prisma.io),
# DIRECT_URL must be the underlying direct connection string, or `db push` will fail to
# reach the database (get it from console.prisma.io's connection settings). For a plain
# local Postgres instance, DIRECT_URL can be the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/sgc?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key"
ADMIN_CODE="set-a-private-admin-code"
POLYGON_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
BLOB_READ_WRITE_TOKEN=""
X_BEARER_TOKEN=""
RESEND_API_KEY=""
FRED_API_KEY=""
FMP_API_KEY=""
