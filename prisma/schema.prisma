generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  passwordHash     String
  name             String?
  role             String      @default("visitor")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  emailToken       String?     @unique
  emailTokenExpiry DateTime?
  emailVerified    Boolean     @default(false)
  teamMemberId     String?     @unique
  tags             String[]    @default([])
  teamMember       TeamMember? @relation(fields: [teamMemberId], references: [id])
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  author      String
  division    String
  tags        String    @default("")
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TeamMember {
  id          String  @id @default(cuid())
  name        String
  title       String  @default("")
  role        String  @default("")
  division    String
  program     String?
  year        String?
  bio         String?
  linkedin    String?
  headshot    String?
  isExecutive Boolean @default(false)
  order       Int     @default(0)
  isAlumni    Boolean @default(false)
  user        User?
}

model Holding {
  id                 String                     @id @default(cuid())
  ticker             String                     @unique
  assetType          String
  quantity           Float
  costBasis          Float?
  entryDate          DateTime                   @default(now())
  notes              String?
  sector             String?
  region             String?
  strategyTag        String?
  visible            Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  apiTicker          String?
  exchange           String                     @default("US")
  committeeDecisions HoldingCommitteeDecision[]
  transactions       Transaction[]
}

model Transaction {
  id             String   @id @default(cuid())
  holdingId      String?
  type           String
  quantity       Float
  price          Float
  fees           Float    @default(0)
  date           DateTime @default(now())
  notes          String?
  createdAt      DateTime @default(now())
  avgCostAtTrade Float?
  cashAfter      Float    @default(0)
  cashBefore     Float    @default(0)
  exchange       String   @default("US")
  positionAfter  Float    @default(0)
  positionBefore Float    @default(0)
  realizedPnL    Float?
  ticker         String
  holding        Holding? @relation(fields: [holdingId], references: [id])
}

model PortfolioSnapshot {
  id             String   @id @default(cuid())
  date           DateTime @unique
  portfolioValue Float
  stocksValue    Float
  cashBalance    Float
  totalCostBasis Float
  realizedPnL    Float    @default(0)
  positionCount  Int      @default(0)
  createdAt      DateTime @default(now())
}

model BenchmarkData {
  id     String   @id @default(cuid())
  ticker String
  date   DateTime
  close  Float

  @@unique([ticker, date])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model MarketData {
  id            String   @id @default(cuid())
  ticker        String   @unique
  price         Float
  change        Float
  changePercent Float
  volume        Int
  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Investment {
  id            String    @id @default(cuid())
  type          String
  title         String
  company       String?
  ticker        String?
  year          String
  season        String
  content       String
  thesis        String?
  entryDate     DateTime?
  priceAtEntry  Float?
  initialTarget Float?
  currentTarget Float?
  tags          String
  published     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  coverImage    String?
  publishDate   DateTime?
  active        Boolean   @default(true)
  exitPrice     Float?
}

model StrategyDocument {
  id               String    @id @default(cuid())
  type             String
  title            String
  year             String
  content          String
  executiveSummary String?
  industries       String?
  sectors          String?
  coverImage       String?
  documentFile     String?
  published        Boolean   @default(false)
  publishDate      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean   @default(false)
  location    String?
  category    String
  subcategory String?
  priority    String    @default("medium")
  status      String    @default("scheduled")
  attendees   String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tags        String[]  @default([])
}

model WeeklyContent {
  id           String    @id @default(cuid())
  title        String
  category     String
  year         String
  season       String
  week         Int
  description  String?
  documentFile String?
  published    Boolean   @default(false)
  publishDate  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  content      String?
  contentType  String    @default("pdf")
}

model InvestmentPitch {
  id           String             @id @default(cuid())
  title        String
  company      String?
  sector       String
  subcategory  String?
  pitchDate    DateTime
  description  String?
  documentFile String?
  published    Boolean            @default(false)
  publishDate  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  feedback     PitchFeedback[]
  participants PitchParticipant[]
}

model HoldingCommitteeDecision {
  id                String                 @id @default(cuid())
  holdingId         String
  meetingDate       DateTime               @default(now())
  finalDecision     String                 @default("pending")
  averageConviction Float?
  keyObjections     String?
  summary           String?
  createdBy         String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  holding           Holding                @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  votes             HoldingCommitteeVote[]

  @@index([holdingId, meetingDate])
}

model HoldingCommitteeVote {
  id         String                   @id @default(cuid())
  decisionId String
  userId     String
  userName   String
  vote       String
  conviction Int
  comment    String?
  objections String?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  decision   HoldingCommitteeDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@unique([decisionId, userId])
  @@index([decisionId])
}

model PitchParticipant {
  id        String          @id @default(cuid())
  pitchId   String
  userId    String
  userName  String
  createdAt DateTime        @default(now())
  pitch     InvestmentPitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  @@unique([pitchId, userId])
  @@index([pitchId])
}

model PitchFeedback {
  id              String          @id @default(cuid())
  pitchId         String
  submittedBy     String
  submittedByName String
  thesisClarity   Int
  variantView     Int
  valuation       Int
  catalysts       Int
  risks           Int
  delivery        Int
  strengths       String?
  improvements    String?
  overallComment  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  pitch           InvestmentPitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  @@unique([pitchId, submittedBy])
  @@index([pitchId])
}

model JobPosting {
  id           String           @id @default(cuid())
  title        String
  description  String
  team         String
  endDate      DateTime
  published    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  documentFile String?
  requirements String?
  roleTag      String?
  applications JobApplication[]
}

model JobApplication {
  id               String     @id @default(cuid())
  jobPostingId     String
  name             String
  email            String
  resumeFile       String?
  appliedAt        DateTime   @default(now())
  faculty          String?
  internshipCount  Int        @default(0)
  internshipFields String[]   @default([])
  subfaculty       String?
  jobPosting       JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
}

model EquityResearchReport {
  id                      String          @id @default(cuid())
  companyName             String
  ticker                  String
  exchange                String
  sector                  String
  industry                String
  reportDate              DateTime        @default(now())
  analysts                String[]        @default([])
  coverageStatus          String
  recommendation          String
  currentPrice            Float
  targetPrice             Float
  impliedUpside           Float
  timeHorizon             String          @default("12 months")
  currency                String          @default("USD")
  status                  String          @default("draft")
  version                 Int             @default(1)
  createdBy               String
  lastEditedBy            String?
  collaborators           String[]        @default([])
  dcfModelId              String?         @unique
  dcfInputs               Json?
  dcfOutputs              Json?
  investmentThesis        Json
  financialSnapshot       Json
  businessModel           String
  unitEconomics           String?
  economicMoat            String?
  industryAnalysis        String
  competitivePosition     Json?
  catalystsNearTerm       Json
  catalystsMediumTerm     Json
  forecastAssumptions     Json
  incomeStatementForecast Json
  cashFlowForecast        Json
  valuationMethod         String
  valuationAnalysis       String
  sensitivityAnalysis     Json
  bearCase                String
  keyRisks                Json
  esgFactors              String?
  governanceIssues        String?
  coverImage              String?
  pdfExport               String?
  excelModel              String?
  published               Boolean         @default(false)
  publishedAt             DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  aiStrategies            String?
  bullBearJustification   String?
  bullCase                String?
  showOnWebsite           Boolean         @default(true)
  dataSource              String?
  epsTableMarkdown        String?
  fiftyTwoWeekRange       String?
  fiscalYearEnd           String?
  marketCap               Float?
  performanceMetrics      Json?
  priceDate               String?
  priceTargetEndDate      String?
  sharesOutstanding       Float?
  forwardPE               Float?
  peRatio                 Float?
  priceHistory            Json?
  dividendYield           Float?
  forwardPEConsensus      Float?
  priceChartImageUrl      String?
  concludingSection       String?
  showPriceChart          Boolean         @default(true)
  sentimentSnapshot       Json?
  dcfModel                SavedDCFModel?  @relation(fields: [dcfModelId], references: [id])
  comments                ReportComment[]
  versions                ReportVersion[]
}

model ReportVersion {
  id        String               @id @default(cuid())
  reportId  String
  version   Int
  snapshot  Json
  createdBy String
  changeLog String?
  createdAt DateTime             @default(now())
  report    EquityResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ReportComment {
  id        String               @id @default(cuid())
  reportId  String
  section   String
  userId    String
  userName  String
  content   String
  resolved  Boolean              @default(false)
  createdAt DateTime             @default(now())
  report    EquityResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ResumeSubmission {
  id               String   @id @default(cuid())
  name             String
  email            String
  faculty          String?
  subfaculty       String?
  internshipCount  Int      @default(0)
  internshipFields String[] @default([])
  resumeFile       String?
  createdAt        DateTime @default(now())
  appliedFor       String?
  source           String   @default("direct")
}

model EmployerLogo {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model CommunityInterviewQuestion {
  id            String    @id @default(cuid())
  seedKey       String?   @unique
  question      String
  answer        String?
  notes         String?
  role          String
  subcategory   String?
  questionType  String    @default("technical")
  difficulty    String    @default("medium")
  company       String?
  firmType      String?
  topicTags     String[]  @default([])
  sourceType    String?
  sourceTitle   String?
  sourceUrl     String?
  attachmentUrl String?
  submitterName String?
  submittedBy   String?
  approved      Boolean   @default(false)
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model NewsletterEdition {
  id             String    @id @default(cuid())
  title          String
  issueNumber    Int
  rawContent     String
  sentAt         DateTime?
  recipientCount Int       @default(0)
  status         String    @default("draft")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model MarketingCampaign {
  id                String           @id @default(cuid())
  sourceType        String
  sourceId          String?
  campaignKind      String
  title             String
  status            String           @default("draft")
  sourceSnapshot    Json
  overrideFields    Json?
  generatedCaptions Json?
  createdBy         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  assets            MarketingAsset[]

  @@index([sourceType, sourceId])
  @@index([createdBy, createdAt])
}

model MarketingAsset {
  id         String            @id @default(cuid())
  campaignId String
  platform   String
  assetKind  String
  mimeType   String
  blobUrl    String
  width      Int?
  height     Int?
  ordering   Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, platform, ordering])
}

model OhlcvDaily {
  ticker      String
  date        DateTime
  open        Float
  high        Float
  low         Float
  close       Float
  adjClose    Float
  volume      BigInt
  dividendAmt Float    @default(0)
  splitCoeff  Float    @default(1)

  @@id([ticker, date])
  @@index([ticker, date])
  @@map("ohlcv_daily")
}

model MacroSeriesVintage {
  id              String   @id @default(cuid())
  seriesId        String
  observationDate DateTime
  realtimeStart   DateTime
  realtimeEnd     DateTime
  value           Float?

  @@unique([seriesId, observationDate, realtimeStart])
  @@index([seriesId, observationDate, realtimeStart, realtimeEnd])
  @@map("macro_series_vintage")
}

model EarningsRevision {
  id               String   @id @default(cuid())
  symbol           String
  date             DateTime
  estimatedEpsLow  Float?
  estimatedEpsHigh Float?
  estimatedEpsAvg  Float?
  estimatedRevAvg  Float?
  numAnalystsEps   Int?
  fetchedAt        DateTime @default(now())

  @@unique([symbol, date])
  @@map("earnings_revisions")
}

model FactorFeatureMatrix {
  featureDate          DateTime
  ticker               String
  countryCode          String?
  zGrowth              Float?
  zInflation           Float?
  zMonetary            Float?
  zCredit              Float?
  zCarry               Float?
  zEarnings            Float?
  rankGrowth           Float?
  rankInflation        Float?
  rankMonetary         Float?
  rankCredit           Float?
  rankCarry            Float?
  rankEarnings         Float?
  countryHealthScore   Float?
  flowsRegimeScore     Float?
  countryHealthVintage String?
  dataAsOf             DateTime
  builtAt              DateTime @default(now())

  @@id([featureDate, ticker])
  @@map("factor_feature_matrix")
}

model OecdLeadingIndicator {
  id        String   @id @default(cuid())
  country   String
  period    DateTime
  cliValue  Float
  seriesId  String
  fetchedAt DateTime @default(now())

  @@unique([country, period])
  @@map("oecd_leading_indicators")
}

model IngestLog {
  id           String   @id @default(cuid())
  source       String
  ticker       String?
  seriesId     String?
  startDate    DateTime
  endDate      DateTime
  rowsUpserted Int
  status       String
  errorMsg     String?
  runAt        DateTime @default(now())

  @@map("ingest_log")
}

model SavedDCFModel {
  id            String                @id @default(cuid())
  ticker        String
  companyName   String
  inputs        Json
  outputs       Json
  financialData Json?
  userId        String
  name          String
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  report        EquityResearchReport?
}

model RegimeTemplate {
  id           String   @id @default(cuid())
  fitDate      DateTime
  regimeLabel  String
  labelIndex   Int
  centroidJson String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("regime_templates")
}

model RegimeLabel {
  date        DateTime @id
  regimeLabel String
  labelIndex  Int
  confidence  Float?
  fitId       String
  createdAt   DateTime @default(now())

  @@map("regime_labels")
}

model LearningCuratedItem {
  id          String   @id @default(cuid())
  kind        String   // "book" | "newsletter" | "youtube" | "external_course"
  title       String
  url         String
  description String?
  author      String?
  imageUrl    String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, published, order])
}

model LearningCourse {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  summary     String
  coverImage  String?
  tags        String           @default("")
  published   Boolean          @default(false)
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lessons     LearningLesson[]

  @@index([published, order])
}

model LearningLesson {
  id        String         @id @default(cuid())
  courseId  String
  title     String
  slug      String
  content   String
  order     Int            @default(0)
  published Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  course    LearningCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, slug])
  @@index([courseId, order])
}

model RegimeTransition {
  id         String   @id @default(cuid())
  fitId      String
  fromLabel  String
  toLabel    String
  prob1Day   Float
  prob63Day  Float
  prob126Day Float
  prob252Day Float
  computedAt DateTime @default(now())

  @@unique([fitId, fromLabel, toLabel])
  @@map("regime_transitions")
}

model BacktestRun {
  id               String            @id @default(cuid())
  runAt            DateTime          @default(now())
  dataStart        String
  holdoutStart     String
  windowCount      Int
  stepMonths       Int
  lambdaRidge      Float
  minRegimeSamples Int
  notes            String?
  metrics          BacktestMetric[]
  weightSets       FactorWeightSet[]

  @@map("backtest_runs")
}

model FactorWeightSet {
  id          String      @id @default(cuid())
  runId       String
  regimeLabel String
  wGrowth     Float
  wInflation  Float
  wMonetary   Float
  wCredit     Float
  wCarry      Float
  wEarnings   Float
  sampleCount Int
  isFallback  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  run         BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, regimeLabel])
  @@map("factor_weight_sets")
}

model BacktestMetric {
  id          String      @id @default(cuid())
  runId       String
  window      String
  benchmark   String
  hitRate     Float
  sharpeAnn   Float
  maxDrawdown Float
  startDate   String
  endDate     String
  nPeriods    Int
  createdAt   DateTime    @default(now())
  run         BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, window, benchmark])
  @@map("backtest_metrics")
}

model AllocationSignal {
  id                String   @id @default(cuid())
  runDate           DateTime
  ticker            String
  score             Float
  convictionScore   Float
  direction         String   // "overweight" | "underweight" | "neutral"
  regimeLabel       String
  factorAttribution Json
  rank              Int
  etfTicker         String
  prob6m            Float?
  prob12m           Float?
  createdAt         DateTime @default(now())

  @@unique([runDate, ticker])
  @@map("allocation_signals")
}

model StockScreenResult {
  id                            String   @id @default(cuid())
  runDate                       DateTime
  ticker                        String
  sectorEtf                     String
  rsRating                      Float?
  epsRankProxy                  Float?
  smrProxy                      String?
  dma50Position                 Float?
  dma100Position                Float?
  dma200Position                Float?
  institutionalSponsorshipTrend Float?
  earningsRevisionMomentum      Float?
  compositeScore                Float
  analystConsensus              Json?
  createdAt                     DateTime @default(now())

  @@unique([runDate, ticker])
  @@map("stock_screen_results")
}
