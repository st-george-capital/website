generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  name           String?
  role           String     @default("visitor") // "visitor", "user", "admin"
  tags           String[]   @default([]) // Array of tags for categorization
  emailVerified  Boolean    @default(false)
  emailToken     String?    @unique
  emailTokenExpiry DateTime?
  teamMemberId   String?    @unique
  teamMember     TeamMember? @relation(fields: [teamMemberId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  author      String
  division    String
  tags        String    @default("")
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TeamMember {
  id          String  @id @default(cuid())
  name        String
  title       String  @default("")
  role        String  @default("")
  division    String
  program     String?
  year        String?
  bio         String?
  linkedin    String?
  headshot    String?
  isExecutive Boolean @default(false)
  isAlumni    Boolean @default(false)
  order       Int     @default(0)
  user        User?
}

model Holding {
  id           String        @id @default(cuid())
  ticker       String        @unique
  apiTicker    String?       // Ticker with exchange suffix for API calls (e.g., "RY.TRT")
  exchange     String        @default("US") // "US", "TRT", "TRV", "LON"
  assetType    String
  quantity     Float
  costBasis    Float?
  entryDate    DateTime      @default(now())
  notes        String?
  sector       String?
  region       String?
  strategyTag  String?
  visible      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id             String   @id @default(cuid())
  holdingId      String?
  ticker         String   // Denormalized: preserved even if holding is deleted
  type           String   // "BUY" or "SELL"
  quantity       Float
  price          Float
  fees           Float    @default(0)
  exchange       String   @default("US")
  date           DateTime @default(now())
  notes          String?
  positionBefore Float    @default(0)
  positionAfter  Float    @default(0)
  cashBefore     Float    @default(0)
  cashAfter      Float    @default(0)
  realizedPnL    Float?   // Only populated on SELL trades
  avgCostAtTrade Float?   // Snapshot of avg cost basis at time of trade
  createdAt      DateTime @default(now())
  holding        Holding? @relation(fields: [holdingId], references: [id], onDelete: SetNull)
}

model PortfolioSnapshot {
  id             String   @id @default(cuid())
  date           DateTime @unique
  portfolioValue Float    // Total = stocks + cash
  stocksValue    Float
  cashBalance    Float
  totalCostBasis Float
  realizedPnL    Float    @default(0)
  positionCount  Int      @default(0)
  createdAt      DateTime @default(now())
}

model BenchmarkData {
  id     String   @id @default(cuid())
  ticker String
  date   DateTime
  close  Float

  @@unique([ticker, date])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model MarketData {
  id            String   @id @default(cuid())
  ticker        String   @unique
  price         Float
  change        Float
  changePercent Float
  volume        Int
  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Investment {
  id              String   @id @default(cuid())
  type            String   // "thesis" or "outlook"
  title           String
  company         String?
  ticker          String?
  year            String   // Year as string to allow any year
  season          String   // "Fall", "Winter", "Summer"
  content         String   // Full thesis/outlook content
  thesis          String?  // Why we invested
  entryDate       DateTime?
  priceAtEntry    Float?
  initialTarget   Float?   // Price target when invested
  currentTarget   Float?   // Current price target
  exitPrice       Float?   // Price when position was exited
  active          Boolean  @default(true) // Whether position is still active
  publishDate     DateTime? // When to publish/display on holdings
  tags            String   // Comma-separated: "Equity", "Macro", "Investment Strategy"
  coverImage      String?  // Cover image URL
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StrategyDocument {
  id              String   @id @default(cuid())
  type            String   // "investment_strategy" or "industry_report"
  title           String
  year            String   // Year as string
  content         String   // Full document content (markdown)
  executiveSummary String? // Brief summary for display
  industries      String?  // Comma-separated industries covered
  sectors         String?  // Comma-separated sectors covered
  coverImage      String?  // Cover image URL
  documentFile    String?  // PDF document URL if uploaded
  published       Boolean  @default(false)
  publishDate     DateTime? // When to publish/display
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean  @default(false)
  location    String?
  category    String   // "quant_trading", "quant_research", "macro", "equity"
  subcategory String?  // For macro/equity: "financials", "consumer", "energy", "healthcare", "macro_technology"
  priority    String   @default("medium") // "low", "medium", "high", "urgent"
  status      String   @default("scheduled") // "scheduled", "in_progress", "completed", "cancelled"
  attendees   String?  // Comma-separated user IDs
  tags         String[] @default([]) // Array of tags for categorization
  createdBy    String   // User ID who created the event
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeeklyContent {
  id           String   @id @default(cuid())
  title        String
  category     String   // "news", "learning"
  year         String   // Year as string
  season       String   // "winter", "summer", "fall"
  week         Int      // Week number 1-52
  description  String?
  contentType  String   @default("pdf") // "pdf" or "markdown"
  content      String?  // Markdown content when contentType is "markdown"
  documentFile String?  // PDF file URL
  published    Boolean  @default(false)
  publishDate  DateTime? // When to publish
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InvestmentPitch {
  id          String   @id @default(cuid())
  title       String
  company     String?
  sector      String   // "macro", "equity"
  subcategory String?  // For macro/equity subsectors
  pitchDate   DateTime
  description String?
  documentFile String? // PDF file URL
  published   Boolean  @default(false)
  publishDate DateTime? // When to publish
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JobPosting {
  id           String   @id @default(cuid())
  title        String
  description  String
  team         String   // "quant_trading", "quant_research", "macro", "equity"
  endDate      DateTime
  published    Boolean  @default(false)
  documentFile String?  // PDF document URL
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications JobApplication[]
}

model JobApplication {
  id            String     @id @default(cuid())
  jobPostingId  String
  name          String
  email         String
  faculty       String?
  subfaculty    String?
  internshipCount Int      @default(0)
  internshipFields String[] @default([])
  resumeFile    String?    // Resume file URL
  appliedAt     DateTime   @default(now())

  jobPosting    JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
}

model EquityResearchReport {
  id                    String   @id @default(cuid())
  
  // Metadata
  companyName           String
  ticker                String
  exchange              String
  sector                String
  industry              String
  reportDate            DateTime @default(now())
  analysts              String[] @default([]) // Array of analyst names
  coverageStatus        String   // "initiation" | "update"
  recommendation        String   // "buy" | "hold" | "sell" | "overweight" | "neutral" | "underweight"
  currentPrice          Float
  targetPrice           Float
  impliedUpside         Float    // Calculated: (targetPrice - currentPrice) / currentPrice
  timeHorizon           String   @default("12 months")
  currency              String   @default("USD")
  // Company snapshot (JPM-style)
  priceDate             String?  // e.g. "29 Sep 15"
  fiftyTwoWeekRange     String?  // e.g. "22.81-39.27"
  marketCap             Float?   // in millions
  sharesOutstanding     Float?   // in millions
  fiscalYearEnd         String?  // e.g. "Jun"
  priceTargetEndDate    String?  // e.g. "31-Dec-16"
  performanceMetrics    Json?    // { absYTD, abs1m, abs3m, abs12m, relYTD, rel1m, rel3m, rel12m }
  epsTableMarkdown      String?  @db.Text // EPS table (markdown or pasted)
  dataSource            String?  @db.Text // e.g. "Company data, Bloomberg, J.P. Morgan estimates"
  peRatio               Float?   // From API / DCF
  forwardPE             Float?   // Calculated from DCF projections
  forwardPEConsensus    Float?   // From API (analyst consensus)
  dividendYield         Float?   // From API (as percentage, e.g. 2.5 for 2.5%)
  priceChartImageUrl    String?  // Custom uploaded chart image URL (fallback if priceHistory unavailable)
  showPriceChart        Boolean  @default(true) // Whether to include the price chart in the published report
  priceHistory          Json?   // [{ date, close }] for chart (from DCF/API)
  
  // Report Status & Collaboration
  status                String   @default("draft") // "draft" | "under_review" | "published"
  version               Int      @default(1)
  createdBy             String   // User ID
  lastEditedBy          String?  // User ID
  collaborators         String[] @default([]) // Array of user IDs with edit access
  
  // DCF Integration
  dcfModelId            String?  @unique
  dcfInputs             Json?    // Store DCF inputs for reproducibility
  dcfOutputs            Json?    // Store DCF outputs
  
  // Executive Summary
  investmentThesis      Json     // Array of { claim, driver, mispricing }
  
  // Financial Snapshot
  financialSnapshot     Json     // Structured data: revenue, EBITDA, margins, etc.
  
  // Business Model
  businessModel         String   @db.Text
  unitEconomics         String?  @db.Text
  economicMoat          String?  @db.Text
  
  // Industry Analysis
  industryAnalysis      String   @db.Text
  competitivePosition   Json?    // Structured competitor data
  
  // Catalysts
  catalystsNearTerm     Json     // Array of { event, mechanism, probability }
  catalystsMediumTerm   Json
  
  // Financial Forecasts
  forecastAssumptions   Json     // Structured assumptions
  incomeStatementForecast Json
  cashFlowForecast      Json
  
  // Valuation
  valuationMethod       String   // "dcf" | "multiples" | "both"
  valuationAnalysis     String   @db.Text
  sensitivityAnalysis   Json
  
  // Risks & Scenarios
  bearCase              String   @db.Text
  bullCase              String?  @db.Text
  bullBearJustification String?  @db.Text  // Optional justification for bull/bear cases
  keyRisks              Json     // Array of risk objects
  
  // AI & Strategy
  aiStrategies          String?  @db.Text   // Company AI strategy / use of AI
  
  // ESG
  esgFactors            String?  @db.Text
  governanceIssues      String?  @db.Text
  
  // Conclusion
  concludingSection     String?  @db.Text
  
  // Files & Exports
  coverImage            String?
  pdfExport             String?
  excelModel            String?
  
  // Publishing
  published             Boolean  @default(false)
  publishedAt           DateTime?
  showOnWebsite         Boolean  @default(true)  // Can hide from public without deleting
  
  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  dcfModel              SavedDCFModel? @relation(fields: [dcfModelId], references: [id])
  versions              ReportVersion[]
  comments              ReportComment[]
}

model ReportVersion {
  id                    String   @id @default(cuid())
  reportId              String
  version               Int
  snapshot              Json     // Full report snapshot
  createdBy             String   // User ID
  changeLog             String?
  createdAt             DateTime @default(now())
  
  report                EquityResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ReportComment {
  id                    String   @id @default(cuid())
  reportId              String
  section               String   // Which section
  userId                String
  userName              String
  content               String   @db.Text
  resolved              Boolean  @default(false)
  createdAt             DateTime @default(now())
  
  report                EquityResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ResumeSubmission {
  id               String   @id @default(cuid())
  name             String
  email            String
  faculty          String?  // "engineering" | "arts_science" | "rotman" — null for job applicants
  subfaculty       String?
  internshipCount  Int      @default(0)
  internshipFields String[] @default([])
  resumeFile       String?  // PDF URL — may be null if synced from application without file
  source           String   @default("direct")  // "direct" | "job_application"
  appliedFor       String?  // Job posting title (preserved even after posting is deleted)
  createdAt        DateTime @default(now())
}

model EmployerLogo {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model CommunityInterviewQuestion {
  id            String    @id @default(cuid())
  seedKey       String?   @unique
  question      String    @db.Text
  answer        String?   @db.Text
  notes         String?   @db.Text
  role          String    // "sales_trading" | "investment_banking" | "buyside" | "consulting" | "general_finance" | "behavioural"
  subcategory   String?   // e.g. "quant_trading", "technical", "case_interview"
  questionType  String    @default("technical") // "technical" | "market" | "fit" | "case" | "brainteaser" | "product"
  difficulty    String    @default("medium") // "easy" | "medium" | "hard"
  company       String?
  firmType      String?
  topicTags     String[]  @default([])
  sourceType    String?
  sourceTitle   String?
  sourceUrl     String?
  attachmentUrl String?
  submitterName String?
  submittedBy   String?   // User ID
  approved      Boolean   @default(false)
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model NewsletterEdition {
  id              String    @id @default(cuid())
  title           String
  issueNumber     Int
  rawContent      String    @db.Text
  sentAt          DateTime?
  recipientCount  Int       @default(0)
  status          String    @default("draft") // "draft" | "sent"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SavedDCFModel {
  id                    String   @id @default(cuid())
  ticker                String
  companyName           String
  inputs                Json     // Full DCF inputs
  outputs               Json     // Calculated outputs
  financialData         Json?    // Historical financial data
  userId                String
  name                  String
  notes                 String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  report                EquityResearchReport?
}
